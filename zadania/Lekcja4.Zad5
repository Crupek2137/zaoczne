using System;
using System.Collections.Generic;

class Program
{
    static void Main()
    {
        Dictionary<string, int> magazyn = new Dictionary<string, int>();

        while (true)
        {
            Console.WriteLine("1. Dodaj produkt, 2. Wyswietl stan magazynu, 3. Usun produkt, 0. Wyjdz");
            int liczba = int.Parse(Console.ReadLine());

            if (liczba == 0)
            {
                break; 
            }
            else if (liczba == 1)
            {
                Console.WriteLine("Podaj nazwę produktu:");
                string nazwa = Console.ReadLine();
                Console.WriteLine("Podaj ilość sztuk:");
                int ilosc = int.Parse(Console.ReadLine());

                if (magazyn.ContainsKey(nazwa))
                {
                    magazyn[nazwa] += ilosc;
                }
                else
                {
                    magazyn.Add(nazwa, ilosc); 
                }
                Console.WriteLine($"Dodano produkt: {nazwa}, Ilość: {ilosc}");
            }
            else if (liczba == 2)
            {
                Console.WriteLine("Stan magazynu:");
                foreach (var produkt in magazyn)
                {
                    Console.WriteLine($"Produkt: {produkt.Key}, Ilość: {produkt.Value}");
                }
            }
            else if (liczba == 3)
            {
                Console.WriteLine("Podaj nazwę produktu do usunięcia:");
                string nazwa = Console.ReadLine();
                if (magazyn.Remove(nazwa))
                {
                    Console.WriteLine($"Usunięto produkt: {nazwa}");
                }
                else
                {
                    Console.WriteLine("Nie ma produktu o takiej nazwie");
                }
            }
            else
            {
                Console.WriteLine("Nieprawidłowa opcja, spróbuj ponownie.");
            }
        }
    }
}
